# Connection string for PostgreSQL (dev: container `leandrosys-db`, porta 5433).
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://leandrosys:leandrosys@localhost:5433/leandrosys"

# Segredo dos tokens JWT (troque em produção).
JWT_SECRET="dev-secret-troque-em-producao"

# Porta do servidor API.
PORT=3000

# Origem permitida no CORS (frontend Vite).
CORS_ORIGIN="http://localhost:5173"

# Codigo de pareamento do concentrador (desktop) — troque em producao.
