# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Segredo usado para assinar os tokens JWT.
JWT_SECRET="change-me"

# Porta do servidor API (padrão 3001; Next.js usa a porta 3000).
PORT=3001

# Origem permitida no CORS (frontend Next.js).
CORS_ORIGIN="http://localhost:3000"

