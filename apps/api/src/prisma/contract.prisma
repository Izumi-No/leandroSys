// use prisma-8
//
// leandroSys — comandas, mesas e impressão.
// Timestamps usam TimestamptzJsDate (codec JS `Date`, não exige global Temporal).

// ---------------------------------------------------------------------------
// Identidade
// ---------------------------------------------------------------------------

enum Role {
    ADMIN
    WAITER
    CASHIER
    CHEF
}


model User {
    id        Uuid   @id @onCreate(uuid())
    username  String @unique
    password  String
    role      Role?
    createdAt TimestamptzJsDate @default(now())

    comandas Comanda[]
}

// ---------------------------------------------------------------------------
// Cardápio
// ---------------------------------------------------------------------------

model Category {
    id     Uuid   @id @onCreate(uuid())
    name   String @unique
    active Boolean @default(true)

    products    Product[]
    printRoutes PrintRoute[]
    aditionals  Aditional[] @relation("CategoryAditionals")
}

model Product {
    id         Uuid   @id @onCreate(uuid())
    name       String
    price      Decimal
    categoryId Uuid
    category   Category @relation(fields: [categoryId], references: [id])
    active     Boolean  @default(true)

    items       ComandaItem[]
    printRoutes PrintRoute[]
    aditionals  Aditional[] @relation("ProductAditionals")
}

model Aditional {
    id         Uuid   @id @onCreate(uuid())
    name       String
    price      Decimal
    categoryId Uuid?
    category   Category? @relation(name: "CategoryAditionals", fields: [categoryId], references: [id], onDelete: SetNull)
    productId  Uuid?
    product    Product?  @relation(name: "ProductAditionals", fields: [productId], references: [id], onDelete: SetNull)
    active     Boolean  @default(true)

    comandaItems ComandaItemAditional[]

    @@index([categoryId])
    @@index([productId])
}

// ---------------------------------------------------------------------------
// Mesas e comandas
// ---------------------------------------------------------------------------

enum TableStatus {
    AVAILABLE
    OCCUPIED
    RESERVED
}

model Table {
    id       Uuid   @id @onCreate(uuid())
    number   Int    @unique
    capacity Int    @default(4)
    label    String?
    status   TableStatus @default(AVAILABLE)

    comandas Comanda[]
}

enum ComandaStatus {
    OPEN
    PAYING
    CLOSED
}

enum PaymentMethod {
    MONEY
    CARD
    PIX
    OTHER
}

model Comanda {
    id            Uuid   @id @onCreate(uuid())
    number        Int    @unique @default(autoincrement())
    tableId       Uuid
    table         Table  @relation(fields: [tableId], references: [id])
    status        ComandaStatus @default(OPEN)
    waiterId      Uuid?
    waiter        User?  @relation(fields: [waiterId], references: [id])
    total         Decimal @default(0)
    paymentMethod PaymentMethod?
    openedAt      TimestamptzJsDate @default(now())
    closedAt      TimestamptzJsDate?

    items ComandaItem[]
    jobs  PrintJob[]
}

enum ItemStatus {
    PENDING
    SENT
    IN_PREP
    READY
    SERVED
    CANCELED
}

model ComandaItem {
    id        Uuid   @id @onCreate(uuid())
    comandaId Uuid
    comanda   Comanda @relation(fields: [comandaId], references: [id], onDelete: Cascade)
    productId Uuid
    product   Product @relation(fields: [productId], references: [id])
    quantity  Int     @default(1)
    unitPrice Decimal
    note      String?
    status    ItemStatus @default(PENDING)
    createdAt TimestamptzJsDate @default(now())

    aditionals ComandaItemAditional[]
    jobs       PrintJob[]
}

// Junção explícita item <-> adicional (m2m implícito é recusado no Prisma 8).
model ComandaItemAditional {
    comandaItemId Uuid
    comandaItem   ComandaItem @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
    aditionalId   Uuid
    aditional     Aditional   @relation(fields: [aditionalId], references: [id], onDelete: Cascade)

    @@id([comandaItemId, aditionalId])
    @@index([aditionalId])
}

// ---------------------------------------------------------------------------
// Impressão
// ---------------------------------------------------------------------------

enum PrinterTransport {
    BLUETOOTH
    USB
    NETWORK
}

model Printer {
    id        Uuid   @id @onCreate(uuid())
    name      String @unique
    address   String
    transport PrinterTransport @default(BLUETOOTH)
    columns   Int    @default(32)
    codepage  Int    @default(19)
    active    Boolean @default(true)
    // Impressora que recebe o fechamento de conta (só uma fica true por vez).
    printsBill Boolean @default(false)
    createdAt TimestamptzJsDate @default(now())

    // Vínculo com o agente (printd) que drena esta fila. O agente preenche
    // address/transport/baud ao atrelar um dispositivo local descoberto.
    agentId   String?
    agentName String?
    baud      Int?
    boundAt   TimestamptzJsDate?

    routes PrintRoute[]
    jobs   PrintJob[]

    @@index([agentId])
}

// Rota de impressão: exatamente um alvo (produto OU categoria).
// Escopo é derivado — productId preenchido => PRODUCT, senão => CATEGORY.
model PrintRoute {
    id         Uuid   @id @onCreate(uuid())
    printerId  Uuid
    printer    Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)
    productId  Uuid?
    product    Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
    categoryId Uuid?
    category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    priority   Int    @default(0)
    createdAt  TimestamptzJsDate @default(now())

    @@index([productId])
    @@index([categoryId])
    @@index([printerId])
}

enum PrintJobStatus {
    PENDING
    PRINTING
    DONE
    FAILED
    CANCELED
}

enum PrintJobKind {
    ITEM
    COMANDA
    BILL
    TEST
}

model PrintJob {
    id           Uuid   @id @onCreate(uuid())
    printerId    Uuid
    printer      Printer @relation(fields: [printerId], references: [id], onDelete: Cascade)
    comandaId    Uuid?
    comanda      Comanda? @relation(fields: [comandaId], references: [id], onDelete: SetNull)
    comandaItemId Uuid?
    item         ComandaItem? @relation(fields: [comandaItemId], references: [id], onDelete: Cascade)
    kind         PrintJobKind
    payload      Json
    status       PrintJobStatus @default(PENDING)
    attempts     Int    @default(0)
    lastError    String?
    createdAt    TimestamptzJsDate @default(now())
    claimedAt    TimestamptzJsDate?
    finishedAt   TimestamptzJsDate?

    @@index([printerId, status])
    @@index([comandaId])
}
