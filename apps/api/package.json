{
  "name": "@leandrosys/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de comandas, mesas e fila de impressão (Hono + Kysely + Neon)",
  "scripts": {
    "build": "tsc",
    "deploy": "tsc && wrangler deploy",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "db:ddl": "node scripts/gen-ddl.mjs",
    "db:ddl:apply": "node scripts/apply-ddl.cjs",
    "db:ddl:reset": "node scripts/clean-db.cjs && node scripts/apply-ddl.cjs",
    "db:types": "node scripts/gen-types.cjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "dotenv": "^18.0.9",
    "hono": "^4.13.13",
    "iconv-lite": "^0.7.3",
    "kysely": "^0.29.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "wrangler": "^4.153.0"
  }
}